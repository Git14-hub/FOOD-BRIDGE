# FoodBridge Environment Configuration
# Copy this file to .env and fill in real values before running in production.

FLASK_SECRET_KEY=replace-with-a-long-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foodbridge

MAX_UPLOAD_MB=5
